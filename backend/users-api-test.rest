### Variable definitions
@baseUrl = http://localhost:3001/api/v1

#################################################
### V1 Modular Routes (/api/v1/users)         ###
#################################################

### 1. [v1] Get all users
GET {{baseUrl}}/users

### 2. [v1] Get user by ID (Success)
GET {{baseUrl}}/users/1

### 3. [v1] Get user by ID (Not Found -> 404)
GET {{baseUrl}}/users/999

### 4. [v1] Create user (Success -> 201)
POST {{baseUrl}}/users
Content-Type: application/json

{
  "username": "David",
  "email": "david@example.com",
  "password": "pass1234"
}

### 5. [v1] Create user (Validation Error -> 400)
POST {{baseUrl}}/users
Content-Type: application/json

{
  "username": "Incomplete User"
}

### 6. [v1] Update user by ID
PUT {{baseUrl}}/users/2
Content-Type: application/json

{
  "username": "Alice Updated",
  "email": "aliceupdated@example.com",
  "password": "newpass1234"
}

### 7. [v1] Delete user by ID
DELETE {{baseUrl}}/users/2

### 8. [v1] Trigger Centralized Error Handling (Invalid JSON syntax)
POST {{baseUrl}}/users
Content-Type: application/json

{
  "invalid_json"
}
